# Copy this file to .env for local live-test runs only. Do not commit .env.
MINIPROTO_INTEGRATION=0
# test is the default target. Set production only for explicit real-DC experiments after test DCs pass.
MINIPROTO_LIVE_MODE=test
MINIPROTO_REAL_INTEGRATION=0
MINIPROTO_API_ID=
MINIPROTO_API_HASH=
MINIPROTO_SESSION_KEY=replace-with-at-least-16-random-bytes
# Test DC endpoints are visible in my.telegram.org/apps after the api_id exists. Fill any DCs you want to exercise.
MINIPROTO_TEST_DC1=
MINIPROTO_TEST_DC2=
MINIPROTO_TEST_DC3=
MINIPROTO_TEST_DC4=
MINIPROTO_TEST_DC5=
MINIPROTO_TEST_DC_ID=2
# Test-account phones use Telegram's reserved test pattern. Example shape: 99966XYYYY, where X is the test account DC digit and YYYY is random.
MINIPROTO_TEST_PHONE=
MINIPROTO_TEST_CODE=
MINIPROTO_TEST_PASSWORD=
MINIPROTO_BOT_TOKEN=
# Production credentials are optional and ignored unless MINIPROTO_REAL_INTEGRATION=1.
MINIPROTO_REAL_DC_ID=2
MINIPROTO_REAL_PHONE=
# Phone login codes are one-time values; set this to 1 only for interactive local runs so pytest can prompt for the current code.
MINIPROTO_LIVE_PROMPT_CODE=0
MINIPROTO_REAL_PASSWORD=
MINIPROTO_TEST_SAVED_MESSAGE_TEXT=miniproto live saved-message smoke
MINIPROTO_TEST_UPLOAD_FILE=tests/fixtures/media/smoke.txt
MINIPROTO_TEST_DOWNLOAD_PATH=.tmp/miniproto-live-download.bin
