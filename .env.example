# Copy this file to .env for local live-test runs only. Do not commit .env.
MINIPROTO_INTEGRATION=0
# test is the default target. Set production only for explicit real-DC experiments after test DCs pass.
MINIPROTO_LIVE_MODE=test
MINIPROTO_REAL_INTEGRATION=0
MINIPROTO_API_ID=
MINIPROTO_API_HASH=
MINIPROTO_SESSION_KEY=replace-with-at-least-16-random-bytes
# Test DC endpoints are visible in my.telegram.org/apps after the api_id exists. Fill any DCs you want to exercise.
MINIPROTO_TEST_DC1=
MINIPROTO_TEST_DC2=
MINIPROTO_TEST_DC3=
MINIPROTO_TEST_DC4=
MINIPROTO_TEST_DC5=
MINIPROTO_TEST_DC_ID=2
# Test-account phones use Telegram's reserved test pattern. Example shape: 99966XYYYY, where X is the test account DC digit and YYYY is random.
MINIPROTO_TEST_PHONE=
MINIPROTO_TEST_CODE=
MINIPROTO_TEST_PASSWORD=
MINIPROTO_BOT_TOKEN=
# Production credentials are optional and ignored unless MINIPROTO_REAL_INTEGRATION=1.
MINIPROTO_REAL_DC_ID=2
MINIPROTO_REAL_PHONE=
# Phone login codes are one-time values; set this to 1 only for interactive local runs so pytest can prompt for the current code.
MINIPROTO_LIVE_PROMPT_CODE=0
MINIPROTO_REAL_PASSWORD=
MINIPROTO_TEST_SAVED_MESSAGE_TEXT=miniproto live saved-message smoke
MINIPROTO_TEST_UPLOAD_FILE=tests/fixtures/media/smoke.txt
MINIPROTO_TEST_DOWNLOAD_PATH=.tmp/miniproto-live-download.bin
# Heavy opt-in live media-limit benchmark. This creates/uploads/downloads a ~2000 MiB payload and should never run in routine tests.
MINIPROTO_LIVE_BENCH=0
MINIPROTO_LIVE_BENCH_ACTOR=both
MINIPROTO_LIVE_BENCH_DC_ID=4
MINIPROTO_LIVE_BENCH_SIZE=telegram-default
MINIPROTO_LIVE_BENCH_FILE=.tmp/miniproto-live-bench-2000mib.bin
MINIPROTO_LIVE_BENCH_DOWNLOAD_DIR=.tmp/live-bench-downloads
MINIPROTO_LIVE_BENCH_UPLOAD_CONCURRENCY=8
MINIPROTO_LIVE_BENCH_DOWNLOAD_CONCURRENCY=1
# Empty media-lane values follow the matching concurrency. Set 0 to compare the legacy main-sender path.
MINIPROTO_LIVE_BENCH_UPLOAD_MEDIA_LANES=
MINIPROTO_LIVE_BENCH_DOWNLOAD_MEDIA_LANES=
MINIPROTO_LIVE_BENCH_REQUEST_TIMEOUT=120
MINIPROTO_LIVE_BENCH_UPLOAD_REQUEST_TIMEOUT=45
MINIPROTO_LIVE_BENCH_UPLOAD_PART_RETRIES=6
MINIPROTO_LIVE_BENCH_DOWNLOAD_CHUNK_SIZE=524288
MINIPROTO_LIVE_BENCH_DOWNLOAD_ADAPTIVE_CONCURRENCY=1
MINIPROTO_LIVE_BENCH_DOWNLOAD_REQUEST_TIMEOUT=30
MINIPROTO_LIVE_BENCH_DOWNLOAD_PART_RETRIES=6
MINIPROTO_LIVE_BENCH_DOWNLOAD_FLOOD_SLEEP_THRESHOLD=30
MINIPROTO_LIVE_BENCH_FLOOD_SLEEP_THRESHOLD=300
MINIPROTO_LIVE_BENCH_PROGRESS_INTERVAL=5
MINIPROTO_LIVE_BENCH_LOG_LEVEL=INFO
MINIPROTO_LIVE_BENCH_LOG_FORMAT=text
MINIPROTO_LIVE_BENCH_TRACE_MEMORY=0
# Optional HTTP login-code prompt for fresh user sessions. On GitHub-hosted runners, expose this with a tunnel or prefer pre-made session secrets.
MINIPROTO_LIVE_BENCH_CODE_PROMPT=
MINIPROTO_LIVE_BENCH_HTTP_CODE_HOST=127.0.0.1
MINIPROTO_LIVE_BENCH_HTTP_CODE_PORT=8765
MINIPROTO_LIVE_BENCH_HTTP_CODE_TIMEOUT=900
MINIPROTO_LIVE_BENCH_HTTP_CODE_TOKEN=
MINIPROTO_LIVE_BENCH_HTTP_CODE_PUBLIC_BASE_URL=
# User uploads default to Saved Messages. Bots may need a chat/user/channel peer that already permits the bot to send messages.
MINIPROTO_LIVE_BENCH_USER_PEER=self
MINIPROTO_LIVE_BENCH_BOT_PEER=
