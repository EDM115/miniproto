{
  "name": "miniproto-docs-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "pnpm brand:check",
    "build": "astro build --force",
    "brand:build": "jiti scripts/build-brand.ts",
    "brand:check": "jiti scripts/build-brand.ts --check",
    "check": "pnpm lint && astro check",
    "format": "oxfmt",
    "lint": "oxlint astro.config.ts playwright.config.ts oxfmt.config.ts oxlint.config.ts scripts src tests",
    "preview": "astro preview",
    "serve:static": "jiti scripts/serve-static.ts",
    "test:site": "playwright test"
  },
  "devDependencies": {
    "@astrojs/check": "~0.9.10",
    "@astrojs/markdown-remark": "~7.3.2",
    "@astrojs/starlight": "~0.42.6",
    "@playwright/test": "~1.64.0",
    "@types/node": "^26.6.5",
    "astro": "~7.3.8",
    "jiti": "~2.7.0",
    "oxfmt": "~0.73.0",
    "oxlint": "~1.88.0",
    "oxlint-tsgolint": "~7.0.2004",
    "pagefind": "~1.5.2",
    "sharp": "~0.35.5",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "26"
  },
  "packageManager": "pnpm@11.28.5"
}
