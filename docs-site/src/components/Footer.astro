---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import mark from '../assets/brand/mark.svg';
---

<div class="mp-footer">
  <DefaultFooter {...Astro.props} />
  <div class="mp-footer-floor">
    <a class="mp-footer-brand" href={import.meta.env.BASE_URL} aria-label="miniproto documentation home"><img src={mark.src} width="32" height="32" alt="" /><span>miniproto</span></a>
    <nav aria-label="Project links"><a href="https://github.com/EDM115/miniproto">Source</a><a href={`${import.meta.env.BASE_URL}project/security/`}>Security</a><a href={`${import.meta.env.BASE_URL}project/development/`}>Contribute</a></nav>
  </div>
</div>

<style>
  .mp-footer { padding-top: 1rem; }
  .mp-footer-floor, .mp-footer-brand, .mp-footer-floor nav { display: flex; align-items: center; }
  .mp-footer-floor { gap: 1rem 1.5rem; flex-wrap: wrap; padding: 1.2rem 0 2rem; border-top: 1px solid var(--mp-seam); color: var(--mp-text-faint); font-size: var(--sl-text-xs); }
  .mp-footer-floor p { flex: 1; min-width: 16rem; margin: 0; }
  .mp-footer-brand { gap: 0.55rem; color: var(--sl-color-white); font-family: var(--mp-display-font); font-size: 1rem; text-decoration: none; }
  .mp-footer-brand img { width: 2rem; height: 2rem; }
  .mp-footer-floor nav { gap: 1rem; }
  .mp-footer-floor nav a { color: var(--mp-text-soft); text-decoration-color: transparent; }
  .mp-footer-floor nav a:hover { color: var(--mp-lime); text-decoration-color: currentColor; }
</style>
